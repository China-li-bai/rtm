{
  "id": "ai-recommend",
  "platform": "搜索",
  "title": "AI 猜你喜欢 · 场景融合演示",
  "subtitle": "围绕单位常购、相似商品与关联品类三个推荐场景，展示 AI 猜你喜欢如何在采购资格约束下完成召回、去重、排序、理由展示与反馈评估。",
  "scenarios": [
    {
      "id": "S1",
      "name": "常买的东西，还得重新找",
      "tag": "单位常购",
      "kw": "复购",
      "card": "月底整理补货单，常买的手套、护目镜就在历史订单里，采购人员却还是得重新搜、逐条核对规格。",
      "story": {
        "who": "月底，采购人员打开工作台，准备补齐本单位的常购品。",
        "stuck": "他记得上次买过劳保手套，也记得大概的规格，却想不起具体 SKU 藏在哪张订单里。工作台如果只给全站热门榜，他还是得回到搜索框，从头找起。",
        "consequences": [
          "补货单上的商品要逐项重搜、核规格，时间花在找回旧订单上。",
          "常买 SKU 藏在历史记录里，临时接手采购的人很难顺手找到。",
          "新单位没有足够的历史订单时，系统也不能假装已经了解它的采购偏好。"
        ]
      },
      "solution": {
        "who": "工作台优先呈现当前单位内的高频品类和常购 SKU；有可信的复购周期统计时，再提示可能的补货时间。没有历史数据时，明确标注冷启动兜底的来源。",
        "smooth": "采购打开页面，先看到有依据的“贵单位常购”清单，再结合本次项目和实际规格核对。个人行为数据不足时，不把单位统计包装成“系统懂你”。",
        "effects": [
          "常购品从历史订单走到工作台，减少反复翻旧单和重新搜索。",
          "新接手的采购人员也能从本单位的常购记录入手，不必完全依赖口头交接。",
          "历史不足时如实说明推荐来源，不用虚构的个人偏好填满推荐位。"
        ]
      }
    },
    {
      "id": "S2",
      "name": "想比个相近款，还得来回翻页",
      "tag": "相似商品",
      "kw": "比选",
      "card": "打开安全帽详情页后，采购人员想比较同规格或相近参数的备选商品，却还得返回结果页重新搜索。",
      "story": {
        "who": "采购人员点开一款安全帽或其他具体商品，正在核对规格、价格和供货条件。",
        "stuck": "看完当前商品，他还想找一两款相近规格的商品放在一起比较；页面却没有可信的相似商品入口，只能退回搜索结果、换关键词，再逐个打开详情页。",
        "consequences": [
          "为了比较一两个关键规格，采购人员反复离开详情页、再回来定位。",
          "同款或相近款分散在多个页面，规格差异不容易一眼看清。",
          "如果推荐只因为标题相似、没核对关键属性，反而可能把不合适的商品带进比选清单。"
        ]
      },
      "solution": {
        "who": "详情页以当前商品为起点，查找同款簇中的其他选项、同类目属性近邻和可用的语义近邻；过滤当前商品及无权查看的候选。",
        "smooth": "相似关系来自同款映射、标准属性和语义数据。推荐展示时说明具体依据，并保留有采购意义的规格、SKU 差异；资格和动态供货状态仍需按业务规则校验。",
        "effects": [
          "采购人员可以留在当前商品上下文中查看有比较价值的备选项。",
          "推荐理由能落到“同款关系”或具体属性匹配，而不是笼统地说“AI 觉得相似”。",
          "去重只合并重复记录，不会把不同规格或可选 SKU 错误折叠掉。"
        ]
      }
    },
    {
      "id": "S3",
      "name": "清单差一件，系统没给下一步",
      "tag": "关联品类",
      "kw": "关联采购",
      "card": "购物车里已有劳保手套，采购人员想起可能还要配护目镜；零结果页却只显示“没有找到商品”，没有下一步提示。",
      "story": {
        "who": "采购人员正在收尾一张集中采购清单，或在检索某个商品时碰到了零结果。",
        "stuck": "清单已经快齐了，他还得靠记忆回想有没有经常一起采购的品类；而搜索无结果时，页面也没有基于历史采购关系的备选提示，只能换词再搜。",
        "consequences": [
          "配套品类全靠人回忆，忙起来时容易忘记还有哪些项目需要确认。",
          "为了补齐清单，采购人员又要换词搜索、切换页面，思路和操作被打断。",
          "零结果页没有合理的下一步时，用户只能退出当前流程，或去其他地方继续找。"
        ]
      },
      "solution": {
        "who": "购物车和零结果页读取当前单位内有足够统计依据的历史订单品类关联，生成候选；只有在数据确实支持时，才展示类似“本单位采购这类商品时，也常采购……”的理由。",
        "smooth": "品类共现是采购记录提供的线索，不代表商品必须成套购买。关联强度或样本量不足时隐藏该模块；使用热门兜底时，明确告诉用户它是热门推荐，而不是历史关联。",
        "effects": [
          "存在可靠历史关联时，采购人员可以在当前清单里顺手检查相关品类。",
          "零结果页在有合适候选时提供继续浏览的路径，而不是只留下一个空状态。",
          "统计证据不足时不乱推，避免把偶然同单说成必然搭配。"
        ]
      }
    }
  ],
  "constraints": [
    {
      "id": "C1",
      "name": "采购资格必须先于排序校验",
      "kw": "采购资格",
      "fullTitle": "采购资格必须先于排序校验【目录·权限·供应条件】",
      "card": "相关度高不代表可以采购。推荐必须先核对当前单位与项目的目录权限、供应商资质及适用的价格、库存和配送条件。",
      "reality": "个性化推荐不能授权用户采购无权限商品；目录、项目、供应商、价格与库存状态由各自的业务权威数据源提供。",
      "decision": "把采购资格作为排序前的硬约束。无权、禁采或不满足硬性条件的候选必须剔除；价格、库存等动态状态在进入采购操作时按业务规则再次校验。",
      "land": "落地在采购规则过滤、目录与权限数据供给、供应商准入规则，以及加购或提交采购时的业务校验。"
    },
    {
      "id": "C2",
      "name": "推荐理由必须有证据并可追溯",
      "kw": "可解释",
      "fullTitle": "推荐理由必须有证据并可追溯【理由来源·策略版本】",
      "card": "采购人员需要知道为什么看到某个商品。推荐理由必须能够对应真实的历史采购、商品属性匹配或品类关联证据，不能由模型随意编造。",
      "reality": "单一排序分数不足以支持采购核对；发生异常时，还需要在实际实现范围内定位推荐请求使用的理由、规则与策略。",
      "decision": "优先采用可验证的理由码，并让理由与实际命中的数据来源对应。记录实际展示结果和已实现的策略标识；不把尚未实现的信号贡献度分解或不可篡改日志写成既有能力。",
      "land": "落地在推荐结果组装、理由渲染、曝光与点击日志，以及已实现的策略版本和调用记录。"
    },
    {
      "id": "C3",
      "name": "单位数据隔离与推荐公平",
      "kw": "数据隔离",
      "fullTitle": "单位数据隔离与推荐公平【单位边界·无竞价置顶】",
      "card": "单位采购画像不得越权流转到其他单位；推荐排序应依据与采购目标相关的规则，不由竞价推广或未经授权的人工置顶决定。",
      "reality": "正式需求明确不做跨单位推荐，并且不做竞价推广位；单位常购和关联统计必须尊重租户/单位的数据边界。",
      "decision": "单位画像和品类共现按单位范围隔离；权限在数据访问与候选过滤层落实。排序规则应可说明、可复核，人工干预需有授权与记录。",
      "land": "落地在单位画像和共现数据模型、数据访问权限、候选过滤、策略配置与审计记录。"
    },
    {
      "id": "C4",
      "name": "成本、时延与降级必须可控",
      "kw": "可用性",
      "fullTitle": "成本、时延与降级必须可控【预算·超时·兜底】",
      "card": "推荐服务需要控制计算成本与响应时间。画像或模型服务超时、候选不足时，应按触点策略安全降级，不能拖垮搜索、购物车和采购主流程。",
      "reality": "规则检索、统计关联、向量检索和外部模型调用的成本结构不同；不能在缺乏调用数据时宣称全流程零成本或已达到确定的节约比例。",
      "decision": "按实际实现拆分调用和资源成本，先用可复用数据与确定性规则；为超时、数据不足和服务不可用定义兜底或隐藏策略，并用监控数据验证效果。",
      "land": "落地在召回与排序服务、超时控制、兜底策略、调用预算、成本监控和效果评测。"
    }
  ],
