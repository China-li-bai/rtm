<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.archimatetool.com/archimate" xmlns:archimate="http://www.archimatetool.com/archimate" name="RTM RTM" id="rtm-root" version="1.0">
  <folder name="Motivation" type="motivation">
    <element xsi:type="Requirement" id="S-01" name="供应商推品上架"><property key="goal" value="推品合规、快速进入标准商品池"/></element>
    <element xsi:type="Requirement" id="S-02" name="自然语言找货下单"><property key="goal" value="说人话就能找到货并下单"/></element>
    <element xsi:type="Requirement" id="S-03" name="关键词搜索比选"><property key="goal" value="关键词找货、筛选比选锁定目标"/></element>
    <element xsi:type="Requirement" id="S-04" name="客服咨询即答"><property key="goal" value="商品/订单/FAQ 秒级可溯源回答"/></element>
    <element xsi:type="Requirement" id="S-05" name="售后与转人工"><property key="goal" value="投诉纠纷有人接、夜间不丢件"/></element>
    <element xsi:type="Requirement" id="S-06" name="集采专区合规采买"><property key="goal" value="集采行为全程规则管控"/></element>
    <element xsi:type="Requirement" id="S-07" name="存量商品清洗治理"><property key="goal" value="存量数据达到上架标准"/></element>
    <element xsi:type="Requirement" id="S-08" name="数据飞轮持续优化"><property key="goal" value="行为与坏案例回流让三家越用越强"/></element>
    <element xsi:type="Requirement" id="S-09" name="审核运营与供应商协同"><property key="goal" value="驳回有原因、反馈有闭环、质量可度量"/></element>
    <element xsi:type="Requirement" id="S-10" name="客服运营管理"><property key="goal" value="量、质、风险可管理可汇报"/></element>
  </folder>
